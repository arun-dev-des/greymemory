# API keys for the real extractor (Anthropic) and embedder (OpenAI).
# Required — without these the scenarios cannot run.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Models — defaults work, override only if needed.
EXTRACTOR_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# Optional — where to write the scenario .db files.
# Default is ./.greymemory-scenarios next to this folder.
# GREYMEMORY_SCENARIOS_DIR=./.greymemory-scenarios

# Optional — path to your memory.js if it isn't at the standard location
# (../../greymemory/src/memory.js or ../../greymemory/memory.js).
# GREYMEMORY_MODULE=/abs/path/to/memory.js
