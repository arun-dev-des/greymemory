# Path to the directory containing your benchmark DB files.
# All files matching `*-greymemory.db` (or plain `greymemory.db`) will be
# discovered automatically and shown as datasets in the UI.
#
# Example layout this expects:
#   benchmark/.greymemory-bench/
#     ├── ku-greymemory.db
#     ├── ms-greymemory.db
#     └── ...
#
# Path is relative to the server/ folder, or absolute.
GREYMEMORY_ROOT=../../benchmark/.greymemory-bench

# Server port
PORT=4000

# Optional — only needed if you want live retrieval debugging.
# Without these the explore, scrubber, and showcase modes still work fully.
OPENAI_API_KEY=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
EMBEDDING_MODEL=text-embedding-3-small
