{
  "name": "greymemory",
  "version": "0.1.0",
  "description": "Self-hosted memory layer for AI agents. Local embeddings, semantic search, persistent facts. No API keys required for embeddings.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "greymemory": "./bin/init.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "embeddings",
    "semantic-search",
    "llm",
    "local",
    "privacy",
    "ollama"
  ],
  "author": "Arunkumar",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arun-dev-des/greymemory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun-dev-des/greymemory.git"
  },
  "bugs": {
    "url": "https://github.com/arun-dev-des/greymemory/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@inquirer/prompts": "^8.3.2",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.3.1",
    "ora": "^9.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
