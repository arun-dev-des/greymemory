{
  "name": "greymemory",
  "version": "0.3.1",
  "description": "Self-hosted memory for AI agents. Extracts facts, detects contradictions, builds user profiles. Bring your own LLM. Your data never leaves your server.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "greymemory": "bin/init.js",
    "greymemory-migrate": "bin/migrate.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "embeddings",
    "semantic-search",
    "llm",
    "local",
    "privacy",
    "ollama"
  ],
  "author": "Arunkumar",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arun-dev-des/greymemory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun-dev-des/greymemory.git"
  },
  "bugs": {
    "url": "https://github.com/arun-dev-des/greymemory/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "ora": "^9.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
