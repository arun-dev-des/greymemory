{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/retrieve.mjs --mode=session-start --data=${CLAUDE_PLUGIN_DATA}",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/retrieve.mjs --mode=prompt --data=${CLAUDE_PLUGIN_DATA}",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/capture.mjs --data=${CLAUDE_PLUGIN_DATA}",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
