# greymemory-console server configuration.
#
# The server loads the REPO-ROOT .env (../../.env from this server dir), where
# the API keys already live. The variables below are optional overrides — the
# defaults work out of the box for this repo.

# Port for the unified API (serves /api/viz/* and /api/diag/*). Default 4000.
# PORT=4000

# ── Visualizer surface ────────────────────────────────────────────────────
# Directory of *-greymemory.db files the graph reads. Resolved from the repo
# root. Default points at the scenario DBs that ship with the repo.
# GREYMEMORY_ROOT=greymemory-viz/scenarios/.greymemory-scenarios

# OpenAI key enables live retrieval in the Visualizer (graph search bar).
# Read from the repo-root .env; set there, not here.
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ── Diagnostics surface ───────────────────────────────────────────────────
# Repo root that diag scans for benchmark/results/*.json and
# benchmark/.greymemory-bench*/*.db. Defaults to the repo root. NOTE: this is a
# DISTINCT variable from GREYMEMORY_ROOT (which belongs to the Visualizer) — do
# not reuse the same name for both surfaces.
# GREYMEMORY_DIAG_ROOT=/absolute/path/to/repo

# Diag "Analyze" button calls Claude; needs ANTHROPIC_API_KEY (repo-root .env).
# Live DB-browser search prefers VOYAGE_API_KEY, falls back to OPENAI_API_KEY.
# DIAG_ANALYSIS_MODEL=claude-sonnet-4-6
